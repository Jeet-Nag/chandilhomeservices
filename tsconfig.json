{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["./shared/index.ts"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["shared/**/*", "server/src/**/*", "server/tests/**/*"]
}
