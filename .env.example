# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local: postgresql://postgres:postgres@localhost:5432/chandil_db
# Cloud (Neon Free Tier): postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chandil_home_services
# Database SSL Configuration
# Set to 'false' for local PostgreSQL (default).
# Set to 'true' for remote PostgreSQL with TLS (e.g. Neon, Supabase, Cloud SQL).
DATABASE_SSL=false

# Security & Sessions
JWT_SECRET=chandil-dev-secret-key-change-in-production-min32chars!
# In production, specify allowed frontend origin(s), comma-separated:
# CORS_ORIGIN=https://app.chandilservices.in

# Storage & Support
AUDIO_UPLOAD_DIR=./uploads
SUPPORT_PHONE=+919876543210
SUPPORT_WHATSAPP=+919876543210

# WebAuthn / Passkeys Configuration
RP_ID=localhost
RP_NAME=Chandil Home Services
EXPECTED_ORIGIN=http://localhost:3000
